#!/bin/sh
. "$(dirname "$0")/common"

start_server() {
    if [ -f "$PID_FILE" ] && owned_pid; then
        return 0
    fi
    umask 077
    [ ! -L "$STATE_DIR" ] || { report_error 'DPanel 数据目录不能是符号链接。'; return 1; }
    [ -x "$DPANEL_BIN" ] || { report_error '找不到可执行的 DPanel 二进制。'; return 1; }
    read_config || { report_error 'DPanel 的 connection.conf 无效。'; return 1; }
    write_launcher_config || { report_error '无法更新 DPanel 的 DSM 桌面入口。'; return 1; }
    mkdir -p "$STATE_DIR/data" || return 1
    cd "$STATE_DIR" || return 1

    APP_SERVER_HOST=127.0.0.1
    [ "$LAN" != true ] || APP_SERVER_HOST=0.0.0.0
    HOME="$STATE_DIR"
    PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:/var/packages/ContainerManager/target/usr/bin:/var/packages/Docker/target/usr/bin
    export HOME PATH APP_SERVER_HOST

    if [ -S /var/run/docker.sock ] && [ ! -w /var/run/docker.sock ]; then
        printf '%s\n' 'DPanel does not have access to /var/run/docker.sock. Use a remote Docker endpoint or grant access explicitly.' >> "$LOG_FILE"
    fi

    if ! : > "$PID_FILE" || ! : >> "$LOG_FILE"; then
        report_error '无法写入 DPanel 的运行文件。'
        return 1
    fi
    APP_NAME=dpanel APP_ENV=lite APP_FAMILY=ce APP_DEV=false \
        APP_SERVER_PORT="$PORT" DP_SYSTEM_STORAGE_LOCAL_PATH="$STATE_DIR/data" \
        DP_LOG_CONSOLE_LEVEL=info DP_LOG_FILE_LEVEL=info \
        nohup "$DPANEL_BIN" server:start </dev/null >> "$LOG_FILE" 2>&1 &
    printf '%s\n' "$!" > "$PID_FILE"
    sleep 1
    if ! owned_pid; then
        rm -f -- "$PID_FILE"
        report_error 'DPanel 未能启动，请查看套件数据目录中的 run.log。'
        return 1
    fi
}

stop_server() {
    if [ -f "$PID_FILE" ] && owned_pid; then
        kill -TERM "$pid" 2>/dev/null || :
        remaining=10
        while [ "$remaining" -gt 0 ] && owned_pid; do
            sleep 1
            remaining=$((remaining - 1))
        done
        if owned_pid; then
            kill -KILL "$pid" 2>/dev/null || :
            sleep 1
            if owned_pid; then
                report_error '无法停止 DPanel。'
                return 1
            fi
        fi
    fi
    rm -f -- "$PID_FILE"
}

case "${1:-}" in
    start) start_server ;;
    stop) stop_server ;;
    status)
        [ -f "$PID_FILE" ] || exit 3
        owned_pid || exit 1
        ;;
    *) exit 1 ;;
esac
