#!/bin/sh
set -e
script_dir=$(dirname "$0")
. "$script_dir/common"

backup="$PKG_VAR/.upgrade.env"
[ ! -L "$ENV_FILE" ] && [ -f "$ENV_FILE" ] || report_error "$upgradeNeedsEnv"
[ ! -L "$backup" ] && [ ! -d "$backup" ] || report_error "$invalidBackupPath"
umask 077
tmp=$(mktemp "$PKG_VAR/.upgrade.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
cat "$ENV_FILE" > "$tmp"
mv -f -- "$tmp" "$backup"
