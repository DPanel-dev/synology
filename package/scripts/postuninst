#!/bin/sh
set -e
. "$(dirname "$0")/common"

# Do not delete anything on upgrade or when the user chooses to keep data.
[ "${SYNOPKG_PKG_STATUS:-}" = UNINSTALL ] && [ "${wizard_delete_data:-}" = true ] || exit 0
[ ! -L "$STATE_DIR" ] || report_error 'DPanel 状态目录无效。'
share_path=$(shared_folder_path) || share_path=
if [ -z "$share_path" ] && [ -f "$STATE_DIR/share.path" ]; then
    IFS= read -r share_path < "$STATE_DIR/share.path"
fi
if [ -n "$share_path" ]; then
    # The link may be gone after DSM releases the resource; only accept its
    # saved canonical path if it still names a DSM volume's dpanel share.
    if ! printf '%s\n' "$share_path" | grep -Eq '^/volume[0-9]+/dpanel$' || [ -L "$share_path" ]; then
        report_error '无法安全确认 DPanel 共享目录，未删除数据。'
    fi
    if [ ! -L "$share_path/data" ] && [ -f "$share_path/data/.dpanel-managed" ]; then
        rm -rf -- "$share_path/data"
        rm -f -- "$share_path/run.log"
    fi
fi
rm -rf -- "$STATE_DIR"
rm -f -- "$PID_FILE"
