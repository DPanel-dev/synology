# Shared paths and runtime environment for DSM lifecycle hooks and service.sh.
PKG_ROOT=/var/packages/dpanel
PKG_VAR=${SYNOPKG_PKGVAR:-$PKG_ROOT/var}
PKG_DEST=${SYNOPKG_PKGDEST:-$PKG_ROOT/target}
case "$PKG_VAR" in
    /*) [ "$PKG_VAR" != / ] || exit 1 ;;
    *) exit 1 ;;
esac
SHARE_DIR="$PKG_ROOT/shares/dpanel"
DATA_DIR="$SHARE_DIR/data"
LOG_FILE="$SHARE_DIR/run.log"
PID_FILE="$PKG_VAR/app.pid"
ENV_FILE="$PKG_DEST/server/.env"
DPANEL_BIN="$PKG_DEST/server/dpanel"

case "${SYNOPKG_DSM_LANGUAGE:-}" in
    chs) . "$script_dir/locales/zh-CN.sh" ;;
    *)   . "$script_dir/locales/en-US.sh" ;;
esac

report_error() {
    printf '%s\n' "$1" >&2
    if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" >> "$SYNOPKG_TEMP_LOGFILE"
    fi
    return 1
}

valid_port() {
    case "$1" in
        [1-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9])
            [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] ;;
        *) return 1 ;;
    esac
}

load_env() {
    [ ! -L "$ENV_FILE" ] && [ -f "$ENV_FILE" ] || return 1
    APP_SERVER_HOST=127.0.0.1
    APP_SERVER_PORT=
    # Treat .env as data, not as a shell script. Other app settings may be
    # added explicitly, but DSM paths and platform-specific auth stay fixed.
    while IFS='=' read -r key value || [ -n "$key" ]; do
        case "$key" in
            ''|'#'*) ;;
            APP_SERVER_PORT|APP_ENV|APP_FAMILY|APP_DEV|DP_LOG_CONSOLE_LEVEL|DP_LOG_FILE_LEVEL|INSTALLER_RELEASE|INSTALLER_BASE_IMAGE|HTTP_PROXY|HTTPS_PROXY|NO_PROXY|http_proxy|https_proxy|no_proxy)
                export "$key=$value" ;;
            APP_SERVER_HOST)
                case "$value" in 127.0.0.1|0.0.0.0) APP_SERVER_HOST=$value ;; *) return 1 ;; esac ;;
            APP_NAME|DP_SYSTEM_STORAGE_LOCAL_PATH) ;; # Generated; not user settings.
            *) return 1 ;;
        esac
    done < "$ENV_FILE"
    valid_port "$APP_SERVER_PORT" || return 1
    APP_NAME=dpanel
    DP_SYSTEM_STORAGE_LOCAL_PATH="$DATA_DIR"
    HOME="$DATA_DIR"
    PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:/var/packages/ContainerManager/target/usr/bin:/var/packages/Docker/target/usr/bin
    unset STORAGE_LOCAL_PATH APP_SERVER_SOCKET DP_RUN_IN_FNNAS DP_SYSTEM_BASEURL DP_INIT_USERNAME DP_INIT_PASSWORD
    export APP_NAME APP_SERVER_HOST DP_SYSTEM_STORAGE_LOCAL_PATH HOME PATH
}

owned_pid() {
    IFS= read -r pid < "$PID_FILE" || return 1
    case "$pid" in ''|0*|1|*[!0-9]*) return 1 ;; esac
    # Never signal a stale PID that has been reused by an unrelated service.
    [ "/proc/$pid/exe" -ef "$DPANEL_BIN" ]
}

shared_folder_path() {
    [ -L "$SHARE_DIR" ] && [ -d "$SHARE_DIR" ] || return 1
    readlink -f -- "$SHARE_DIR"
}

log_msg() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" "$*" >> "$LOG_FILE"
}

print_docker_access_help() {
    printf '%s\n' "$dockerAccessHelp"
    cat <<'HELP'
sudo sh -c '/usr/syno/sbin/synogroup --memberadd "$(stat -c "%G" /var/run/docker.sock)" dpanel && /usr/syno/bin/synopkg restart dpanel'
HELP
}
