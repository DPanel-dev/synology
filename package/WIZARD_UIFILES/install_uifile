[
  {
    "step_title": "欢迎安装",
    "items": [
      { "desc": "欢迎安装 DPanel！使用前请阅读 <a href=\"https://dpanel.cc/license\" target=\"_blank\" rel=\"noopener noreferrer\">《服务条款》</a>。如果网络无法访问 Docker Hub，请先为 DSM 的 Container Manager 配置加速或代理。" },
      {
        "type": "multiselect",
        "subitems": [
          {
            "key": "wizard_agree_terms",
            "desc": "我已阅读并同意服务条款",
            "defaultValue": false
          }
        ]
      }
    ]
  },
  {
    "step_title": "应用配置",
    "items": [
      {
        "type": "textfield",
        "desc": "配置应用的启动端口，请避免与其他应用冲突。安装后从可信内网使用 HTTP 访问，请勿将端口转发到公网。",
        "subitems": [
          {
            "key": "DP_APP_SERVER_PORT",
            "desc": "应用端口",
            "defaultValue": "8086",
            "validator": {
              "allowBlank": false,
              "regex": { "expr": "/^[1-9][0-9]{3,4}$/", "errorText": "请输入 1024–65535 之间的端口。" }
            }
          },
          {
            "key": "DP_INIT_USERNAME",
            "desc": "管理员用户名",
            "defaultValue": "admin",
            "validator": {
              "allowBlank": true,
              "regex": { "expr": "/^[a-zA-Z0-9_]*$/", "errorText": "用户名只能包含字母、数字和下划线。" }
            }
          }
        ]
      },
      {
        "type": "password",
        "desc": "密码可留空，安装完成后也可以在 DPanel 中初始化管理员。保留数据重装或升级不会重置已有账号。",
        "subitems": [
          {
            "key": "DP_INIT_PASSWORD",
            "desc": "管理员密码",
            "defaultValue": "",
            "validator": { "allowBlank": true, "minLength": 6 }
          }
        ]
      }
    ]
  }
]
